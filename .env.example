# =============================================================================
# DataMart ETL environment variables. Copy this file:  cp .env.example .env
# The real .env is in .gitignore: never commit credentials.
# The values below are examples for local development: change them.
# =============================================================================

# --- Airflow (image and permissions) -----------------------------------------
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.5
# On Linux set your UID (command: id -u) to avoid permission issues in logs/
AIRFLOW_UID=50000

# --- UI admin user (http://localhost:8080) -----------------------------------
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change_this_admin_password

# --- Airflow metadata database -----------------------------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_this_metadata_password
AIRFLOW_DB_NAME=airflow

# --- Airflow internal secrets ------------------------------------------------
# Generate your own with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=change_this_jwt_secret
AIRFLOW_API_SECRET_KEY=change_this_api_secret
# Optional (encrypts Connection passwords in the metadata DB). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# --- Analytical warehouse (PostgreSQL DWH) -----------------------------------
DWH_DB=datamart_dwh
DWH_USER=dwh_user
DWH_PASSWORD=change_this_dwh_password
# Port exposed on your machine to query the DWH (psql, DBeaver, Power BI)
DWH_HOST_PORT=5433
