# =============================================================================
# Variables de entorno de DataMart ETL. Copia este archivo:  cp .env.example .env
# El .env real está en .gitignore: nunca subas credenciales al repositorio.
# Los valores de abajo son de ejemplo para desarrollo local: cámbialos.
# =============================================================================

# --- Airflow (imagen y permisos) ---------------------------------------------
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.5
# En Linux pon tu UID (comando: id -u) para evitar problemas de permisos en logs/
AIRFLOW_UID=50000

# --- Usuario administrador de la UI (http://localhost:8080) ------------------
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=cambia_esta_clave_admin

# --- Base de metadatos de Airflow --------------------------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambia_esta_clave_metadatos
AIRFLOW_DB_NAME=airflow

# --- Secretos internos de Airflow --------------------------------------------
# Genera valores propios con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=cambia_este_secreto_jwt
AIRFLOW_API_SECRET_KEY=cambia_este_secreto_api
# Opcional (cifra las contraseñas de las Connections en la base de metadatos). Genera con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# --- Repositorio analítico (PostgreSQL DWH) ----------------------------------
DWH_DB=datamart_dwh
DWH_USER=dwh_user
DWH_PASSWORD=cambia_esta_clave_dwh
# Puerto expuesto en tu máquina para consultar el DWH (psql, DBeaver, Power BI)
DWH_HOST_PORT=5433
