*.json  text eol=lf
*.csv   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.cfg   text eol=lf
*.toml  text eol=lf
*.lock  text eol=lf
.env*   text eol=lf

*.png   binary
